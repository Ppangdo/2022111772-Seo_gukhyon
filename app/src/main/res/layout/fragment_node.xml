<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <include layout="@layout/layout_note" />

        <!-- 신체 모형 -->
        <LinearLayout style="@style/Cw.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fig_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_front"
                    style="@style/Cw.Btn"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="앞에서" />

                <TextView
                    android:id="@+id/btn_back"
                    style="@style/Cw.Btn"
                    android:layout_marginStart="4dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="뒤에서" />
            </LinearLayout>

            <com.example.myandroidapp.BodyView
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:layout_marginTop="8dp"
                android:contentDescription="신체 모형" />

            <TextView
                android:id="@+id/fig_hint"
                style="@style/Cw.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <!-- 폰에서는 모형과 같이 보이도록 미배치 칸을 모형 바로 아래에 둔다 -->
            <LinearLayout
                android:id="@+id/tray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tray"
                android:contentDescription="미배치 노드"
                android:minHeight="64dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Cw.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="미배치 노드"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tray_empty"
                    style="@style/Cw.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="미배치 노드가 없습니다." />

                <LinearLayout
                    android:id="@+id/tray_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- 기준 자세 -->
        <LinearLayout style="@style/Cw.Card">

            <TextView
                style="@style/Cw.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기준 자세" />

            <TextView
                style="@style/Cw.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="사용자가 편하게 취할 수 있는 자세를 고른 뒤 측정합니다. 모든 동작은 이 기준에서 계산됩니다." />

            <LinearLayout
                android:id="@+id/base_pills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_measure"
                    style="@style/Cw.Btn.Primary" />

                <TextView
                    android:id="@+id/measure_status"
                    style="@style/Cw.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/measure_bar"
                style="@style/Cw.Bar"
                android:layout_marginTop="12dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="100" />
            </LinearLayout>
        </LinearLayout>

        <!-- 노드 -->
        <LinearLayout style="@style/Cw.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Cw.H2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="노드" />

                <TextView
                    android:id="@+id/node_count"
                    style="@style/Cw.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btn_add_node"
                    style="@style/Cw.Btn.OutlinePrimary" />
            </LinearLayout>

            <TextView
                style="@style/Cw.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="미배치 노드는 신체 모형 바로 아래 칸에 있습니다. 길게 눌러 모형으로 끌어다 놓으면 가장 가까운 부위에 붙습니다. 끌기가 어렵다면 노드를 누른 뒤 부위를 누르세요. 모형의 노드를 길게 눌러 그 칸으로 끌어내면 배치가 해제됩니다." />

            <TextView
                android:id="@+id/btn_shake"
                style="@style/Cw.Btn.Outline"
                android:layout_marginTop="12dp"
                android:text="실물 노드 흔들기 (시뮬레이션)" />

            <TextView
                android:id="@+id/ident_msg"
                style="@style/Cw.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 선택한 부위 · 개인 보정 -->
        <LinearLayout style="@style/Cw.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    style="@style/Cw.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="선택한 부위"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sel_name"
                    style="@style/Cw.H2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sel_has_node"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/cell0"
                        layout="@layout/item_cell" />

                    <include
                        android:id="@+id/cell1"
                        layout="@layout/item_cell" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/cell2"
                        layout="@layout/item_cell" />

                    <include
                        android:id="@+id/cell3"
                        layout="@layout/item_cell" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_led"
                        style="@style/Cw.Btn.Outline"
                        android:text="LED 깜빡이기" />

                    <TextView
                        android:id="@+id/btn_unplace"
                        style="@style/Cw.Btn.Outline"
                        android:layout_marginStart="8dp"
                        android:text="배치 해제" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/sel_no_node"
                style="@style/Cw.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="이 부위에는 노드가 없습니다." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/cw_track" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="개인 보정"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Cw.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="척추 측만증이나 골반 비틀림처럼 표준 자세가 어려운 몸이라면, 실제 몸과 다른 만큼 조절합니다. 2D 모형에는 좌우 기울기만 보입니다." />

            <LinearLayout
                android:id="@+id/sliders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_reset"
                    style="@style/Cw.Btn.Outline"
                    android:text="보정값 초기화" />

                <TextView
                    android:id="@+id/corr_summary"
                    style="@style/Cw.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/confirm_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_warn_box"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="모든 부위의 보정값을 0으로 되돌릴까요? 측정한 기준 자세는 그대로입니다."
                    android:textColor="#6B2A07"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_do_reset"
                        style="@style/Cw.Btn"
                        android:background="@drawable/btn_primary"
                        android:backgroundTint="@color/cw_warn"
                        android:text="되돌리기"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/btn_cancel_reset"
                        style="@style/Cw.Btn.Outline"
                        android:layout_marginStart="8dp"
                        android:text="취소" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
