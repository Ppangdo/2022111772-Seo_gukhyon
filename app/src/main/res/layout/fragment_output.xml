<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            style="@style/Cw.Card"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft"
                android:backgroundTint="#EEF0F3"
                android:paddingLeft="12dp"
                android:paddingTop="6dp"
                android:paddingRight="12dp"
                android:paddingBottom="6dp"
                android:text="다음 단계에서 구현"
                android:textColor="@color/cw_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="출력 연결"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Cw.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="동작마다 어떤 수신 모듈의 어떤 포트로 신호를 보낼지 정하는 화면입니다. 이번 시연에서는 허브 슬롯 번호가 곧 소리 모듈의 트랙 번호입니다."
                android:textSize="15sp" />

            <include
                android:id="@+id/out_sound"
                layout="@layout/item_output" />

            <include
                android:id="@+id/out_motor"
                layout="@layout/item_output" />

            <include
                android:id="@+id/out_led"
                layout="@layout/item_output" />

            <include
                android:id="@+id/out_key"
                layout="@layout/item_output" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
