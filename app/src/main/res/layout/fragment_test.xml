<?xml version="1.0" encoding="utf-8"?>
<!-- D 화면: 흉내 버튼 → 모형과 판정 막대를 나란히 → 최근 발동. 민감도와 기록은 아래 시트 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 사용자 움직임 흉내 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="10dp"
            android:paddingRight="12dp"
            android:paddingBottom="10dp">

            <!-- 폰 센서 모드일 때만 오른쪽에 "기준 잡기"(A 탭에 가지 않고 그 자리에서 기준 자세 측정) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sim_title"
                    style="@style/Cw.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="사용자 움직임 흉내 · 시험용"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_baseline"
                    style="@style/Cw.Btn.OutlinePrimary"
                    android:layout_marginStart="8dp"
                    android:text="기준 잡기"
                    android:visibility="gone" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/sim_buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 모형(왼쪽) + 판정 막대(오른쪽) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/readout"
                    style="@style/Cw.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />

                <com.example.myandroidapp.BodyView
                    android:id="@+id/body"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="신체 모형" />
            </LinearLayout>

            <!-- 글자가 커져 슬롯 3개가 다 안 들어가면 이 열만 스크롤한다(모형은 그대로 보임) -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1.15"
                android:fadeScrollbars="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="허브 동작 실시간 판정"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Cw.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="막대를 누르면 켜기·끄기와 민감도를 바꿀 수 있습니다"
                    android:textSize="14sp" />
            </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- 최근 발동: 누르면 발동 기록 -->
        <LinearLayout
            android:id="@+id/last_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp">

            <TextView
                android:id="@+id/last_fire"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/log_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/cw_primary_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 시트: 민감도 · 출력 · 발동 기록 -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:behavior_skipCollapsed="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/sheet_header"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingRight="8dp">

            <TextView
                style="@style/Cw.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="켜기·끄기 · 민감도 · 발동 기록" />

            <TextView
                android:id="@+id/btn_close_sheet"
                style="@style/Cw.Btn"
                android:text="닫기"
                android:textColor="@color/cw_primary_text" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/sheet_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/sens_card"
                    style="@style/Cw.Card">

                    <TextView
                        style="@style/Cw.H2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="인식 민감도" />

                    <TextView
                        style="@style/Cw.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="포즈형은 일치도가 기준을 넘으면 발동, 교정형은 기준 아래로 1.5초 떨어지면 경고합니다. 평소 움직임에 잘못 발동하면 기준을 올리세요." />

                    <LinearLayout
                        android:id="@+id/sens_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <CheckBox
                        android:id="@+id/send_out"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="출력 실제 보내기"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Cw.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="끄면 스피커는 울리지 않고 화면에만 표시합니다" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/log_card"
                    style="@style/Cw.Card">

                    <TextView
                        style="@style/Cw.H2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="발동 기록" />

                    <LinearLayout
                        android:id="@+id/log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/log_empty"
                        style="@style/Cw.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="아직 발동한 동작이 없습니다. 위의 흉내 버튼을 눌러 보세요." />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
