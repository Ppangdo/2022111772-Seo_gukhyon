<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/slot_num"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/cw_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/slot_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/slot_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/slot_meta"
        style="@style/Cw.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/slot_mismatch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/cw_warn_dark"
        android:textSize="13sp" />

    <com.example.myandroidapp.FlowLayout
        android:id="@+id/slot_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/slot_add"
            style="@style/Cw.Btn.Outline"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="녹화 추가"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/slot_test"
            style="@style/Cw.Btn.Outline"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="테스트"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/slot_out"
            style="@style/Cw.Btn.Outline"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="출력 연결"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/slot_remove"
            style="@style/Cw.Btn.Outline"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="허브에서 빼기"
            android:textSize="13sp" />
    </com.example.myandroidapp.FlowLayout>

    <TextView
        android:id="@+id/slot_empty"
        style="@style/Cw.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="비어 있음"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/slot_pick"
        style="@style/Cw.Btn.Primary"
        android:layout_marginTop="8dp" />
</LinearLayout>
