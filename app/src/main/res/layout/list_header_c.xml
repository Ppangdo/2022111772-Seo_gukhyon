<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/layout_note" />

    <!-- 허브 동기화 상태 -->
    <LinearLayout
        style="@style/Cw.Card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sync_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sync_base"
                style="@style/Cw.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_send"
            style="@style/Cw.Btn.Primary"
            android:layout_marginStart="8dp"
            android:text="지금 보내기" />
    </LinearLayout>

    <!-- 교체할 슬롯 고르기 안내 -->
    <LinearLayout
        android:id="@+id/pick_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_note"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/pick_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/cw_primary_dark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_cancel_pick"
            style="@style/Cw.Btn"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_outline"
            android:text="취소"
            android:textColor="@color/cw_primary_dark" />
    </LinearLayout>

    <!-- 허브에 들어간 동작 -->
    <LinearLayout style="@style/Cw.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                style="@style/Cw.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="허브에 들어간 동작" />

            <TextView
                style="@style/Cw.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="최대 3개" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- 폰에 저장된 동작 (아래 리스트뷰 행들) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Cw.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="폰에 저장된 동작" />

        <TextView
            android:id="@+id/btn_new"
            style="@style/Cw.Btn.OutlinePrimary"
            android:text="새 동작 녹화" />
    </LinearLayout>
</LinearLayout>
